# b.ai OpenAI-compatible API. Create a b.ai API key and never commit it.
LLM_BASE_URL=https://api.b.ai/v1
LLM_API_KEY=B_AI_API_KEY
LLM_MODEL=deepseek-v4-flash
DATASET_PATH=../Dataset.xlsx
CATALOG_PATH=./data/catalog.normalized.json
ENABLE_EMBEDDINGS=false
# CORS: origin cua frontend, phan tach bang dau phay (them domain Vercel khi deploy)
FRONTEND_ORIGINS=http://localhost:5173
