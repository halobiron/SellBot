# AgentRouter OpenAI-compatible API. Create a token at
# https://agentrouter.org/console/token and never commit the real value.
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=AGENT_ROUTER_TOKEN
LLM_MODEL=deepseek-v4-flash
DATASET_PATH=../Dataset.xlsx
CATALOG_PATH=./data/catalog.normalized.json
ENABLE_EMBEDDINGS=false
# CORS: origin cua frontend, phan tach bang dau phay (them domain Vercel khi deploy)
FRONTEND_ORIGINS=http://localhost:5173
